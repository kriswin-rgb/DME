    {
      "parameters": {
        "functionCode": "\nconst b = $json;\nconst title = b.title || 'New video';\nconst summary = b.summary || '';\nconst linkUrl = b.linkUrl || (process.env.CANONICAL_URL_BASE || 'https://example.com');\nconst caption = `${title} \u2014 ${summary}`.slice(0, 240);\nreturn [{ json: { title, summary, caption, linkUrl, videoUrl: b.videoUrl || '' } }];\n"
      },
      "id": "Function_Compose",
      "name": "Compose",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        430,
        200
      ]
    },
