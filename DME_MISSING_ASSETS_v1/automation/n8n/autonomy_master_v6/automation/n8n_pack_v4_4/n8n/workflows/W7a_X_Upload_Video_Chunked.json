        "url": "={{$json.videoUrl}}",
        "options": {
          "responseFormat": "file"
        },
        "method": "GET"
      },
      "id": "HTTP_FetchVideo",
      "name": "FetchVideo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        660,
        180
      ]
    },
    {
      "parameters": {
        "url": "={{`https://upload.twitter.com/1.1/media/upload.json?command=INIT&media_type=video/mp4&media_category=tweet_video&total_bytes={{$binary.data.size}}`}}",
        "options": {},
        "method": "POST",
        "authentication": "oAuth1"
      },
      "id": "HTTP_X_INIT",
      "name": "X_INIT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        880,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "functionCode": "\nconst buf = $prevNode['FetchVideo'].binary.data.data;\nconst total = buf.length;\nconst chunkSize = 4 * 1024 * 1024;\nconst media_id = $prevNode['X_INIT'].json.media_id_string;\nconst items = [];\nlet idx = 0;\nfor (let off=0; off<total; off+=chunkSize){\n  const end = Math.min(off+chunkSize, total);\n  const slice = buf.slice(off, end);\n  items.push({\n    json: { segment_index: idx, total_segments: Math.ceil(total/chunkSize), media_id },\n    binary: { data: { data: slice, mimeType: 'video/mp4', fileName: `chunk_${idx}.mp4` } }\n  });\n  idx++;\n}\nreturn items;\n"
      },
      "id": "Function_BuildChunks",
      "name": "BuildChunks",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{`https://upload.twitter.com/1.1/media/upload.json?command=APPEND&media_id={{$json.media_id}}&segment_index={{$json.segment_index}}`}}",
        "options": {},
        "method": "POST",
        "authentication": "oAuth1",
        "sendBinaryData": true,
        "binaryPropertyName": "data"
      },
      "id": "HTTP_X_APPEND",
      "name": "X_APPEND",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1320,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "functionCode": "\nconst last = $json.segment_index === ($json.total_segments - 1);\nreturn [{ json: { last, media_id: $json.media_id } }];\n"
      },
      "id": "Function_IsLastChunk",
      "name": "IsLastChunk",
      "type": "n8n-nodes-base.function",
