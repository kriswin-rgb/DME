{
  "name": "WF_EXEC_RISK_ALERTS_V1",
  "nodes": [
    {
      "id": "Cron_Exec_Risk_Alerts",
      "name": "Cron: Exec Risk Alerts",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        }
      }
    },
    {
      "id": "HTTP_Get_Guardrails",
      "name": "HTTP: Get Guardrails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.DME_BACKEND_URL || \"http://backend:8000\") + \"/api/guards/status\" }}",
        "responseFormat": "json",
        "options": {}
      }
    },
    {
      "id": "IF_Exec_Halt",
      "name": "IF: Halt or Strategy Breach",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        740,
        300
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": true,
              "value2": "={{ $json[\"requires_halt\"] || (($json[\"halted_strategies\"] || []).length > 0) }}"
            }
          ]
        }
      }
    },
    {
      "id": "Function_Build_Exec_Alert",
      "name": "Function: Build Exec Alert Message",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        980,
        300
      ],
      "parameters": {
        "functionCode": "const item = items[0].json;\n\nconst lines = [];\nconst requiresHalt = !!item.requires_halt;\nconst regime = item.regime || 'unknown';\nconst globalDD = (item.global_drawdown * 100).toFixed(2);\nconst dailyDD = (item.daily_drawdown * 100).toFixed(2);\n\nlines.push(`[DME RISK GOVERNOR] requires_halt=${requiresHalt ? 'YES' : 'no'} regime=${regime}`);\nlines.push(`Global DD: ${globalDD}% Daily DD: ${dailyDD}%`);\nlines.push(`Trades evaluated: ${item.trades_evaluated}`);\n\nconst halted = item.halted_strategies || [];\nif (halted.length > 0) {\n  lines.push(`Halted strategies: ${halted.join(', ')}`);\n}\n\nconst per = item.per_strategy || [];\nif (per.length > 0) {\n  lines.push('Per-strategy status (first 10):');\n  per.slice(0, 10).forEach((s) => {\n    const sdd = (s.strategy_drawdown * 100).toFixed(2);\n    const sddDaily = (s.strategy_daily_drawdown * 100).toFixed(2);\n    lines.push(` - ${s.strategy_id}: halt=${s.requires_halt ? 'YES' : 'no'}, DD=${sdd}%, daily=${sddDaily}%, trades=${s.trades_evaluated}`);\n  });\n}\n\n(item.reasons || []).forEach((r) => lines.push(`Reason: ${r}`));\n\nconst text = lines.join('\\n');\n\nreturn [\n  {\n    json: {\n      subject: '[DME] RISK GOVERNOR ALERT',\n      text\n    }\n  }\n];"
      }
    },
    {
      "id": "Telegram_Exec_Alert",
      "name": "Telegram: Exec Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1220,
        200
      ],
      "parameters": {
        "chatId": "={{ $env.DME_EXEC_TELEGRAM_CHAT_ID }}",
        "text": "={{ $json[\"text\"] }}"
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram_dme_exec_bot",
          "name": "telegram_dme_exec"
        }
      }
    },
    {
      "id": "Email_Exec_Alert",
      "name": "Email: Exec Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1220,
        400
      ],
      "parameters": {
        "subject": "={{ $json[\"subject\"] }}",
        "text": "={{ $json[\"text\"] }}",
        "toList": [
          {
            "email": "={{ $env.DME_EXEC_ALERT_EMAIL }}"
          }
        ]
      },
      "credentials": {
        "smtp": {
          "id": "smtp_dme_main",
          "name": "smtp_dme_main"
        }
      }
    }
  ],
  "connections": {
    "Cron: Exec Risk Alerts": {
      "main": [
        [
          {
            "node": "HTTP: Get Guardrails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP: Get Guardrails": {
      "main": [
        [
          {
            "node": "IF: Halt or Strategy Breach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Halt or Strategy Breach": {
      "main": [
        [
          {
            "node": "Function: Build Exec Alert Message",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Function: Build Exec Alert Message": {
      "main": [
        [
          {
            "node": "Telegram: Exec Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email: Exec Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false,
  "id": "WF_EXEC_RISK_ALERTS_V1",
  "versionId": "1"
}