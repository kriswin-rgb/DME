# .env.example – copy to .env and fill values. Do not commit .env.

########################
# Global
########################
DME_ENV=prod
DME_DOMAIN=dailymacroedge.com

########################
# 1Password / Secrets
########################
DME_1P_CONNECT_URL=https://op-connect.example.internal
DME_1P_CONNECT_TOKEN=REPLACE_WITH_1PASSWORD_CONNECT_TOKEN

########################
# Cloudflare
########################
DME_CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
DME_CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
DME_CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID

########################
# Slack
########################
DME_SLACK_BOT_TOKEN=REPLACE_WITH_SLACK_BOT_TOKEN
DME_SLACK_SIGNING_SECRET=REPLACE_WITH_SLACK_SIGNING_SECRET
DME_SLACK_APP_LEVEL_TOKEN=REPLACE_WITH_SLACK_APP_LEVEL_TOKEN

########################
# Telegram
########################
DME_TELEGRAM_BOT_TOKEN_ALERTS_PROD=REPLACE_WITH_TELEGRAM_BOT_TOKEN
DME_TELEGRAM_ALERTS_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

########################
# n8n
########################
DME_N8N_BASIC_AUTH_USER=admin
DME_N8N_BASIC_AUTH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DME_N8N_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_RANDOM_STRING
DME_N8N_HOST=localhost
DME_N8N_PORT=5678
DME_N8N_PROTOCOL=http

########################
# AI Providers
########################
DME_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
DME_CLAUDE_API_KEY=REPLACE_WITH_CLAUDE_API_KEY

########################
# GitHub
########################
DME_GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN
DME_GITHUB_REPO=owner/dme-infra