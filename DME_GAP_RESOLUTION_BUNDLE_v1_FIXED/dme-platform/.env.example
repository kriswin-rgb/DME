# Core
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/dme
REDIS_URL=redis://localhost:6379/0

# Web app
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000
BLOCKED_COUNTRIES=GB,DE,FR,IT,ES

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NOWPAYMENTS_API_KEY=nowp_...
NOWPAYMENTS_IP_WHITELIST= # optional comma-separated list

# KYC
ONFIDO_WEBHOOK_SECRET=onfido-secret

# Kill switch
EMERGENCY_STOP_CODE=super-secret-stop-code
DME_CORE_KILL_SWITCH_URL=http://dme-core-v5:8080/api/v1/kill-switch
ORCHESTRATOR_INTERNAL_URL=http://orchestrator:8081

# Orchestrator
ORCH_SHARED_SECRET=orchestrator-shared-secret

# Vault
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=development-token
ENTITLEMENT_DB_VAULT_PATH=secret/data/dme/entitlement

# Data ingest
EXCHANGE_API_URL=https://api.example-exchange.com
